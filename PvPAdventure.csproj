<Project>

	<!-- Choose the SDK before its default properties are imported. -->
	<PropertyGroup>
		<Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
	</PropertyGroup>
	<Import Project="Sdk.props" Sdk="Tomat.Terraria.ModLoader.Sdk" Version="2.1.1" Condition="'$(Configuration)' == 'Debug'" />
	<Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" Condition="'$(Configuration)' != 'Debug'" />
	<Import Project="..\tModLoader.targets" Condition="'$(Configuration)' != 'Debug'" />

	<PropertyGroup>
		<TmlVersion>steam</TmlVersion>
		<Nullable>disable</Nullable>
		<AssemblyName>PvPAdventure</AssemblyName>
		<LangVersion>latest</LangVersion>
		<!-- tModLoader dependency packaging writes shared files and cannot run concurrently. -->
		<BuildInParallel>false</BuildInParallel>
		<NoWarn>$(NoWarn);CS0436</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ErkySSC\ErkySSC.csproj" />
		<ProjectReference Include="..\PvPFramework\PvPFramework.csproj" />
		<ProjectReference Include="..\Pylon\Pylon.csproj" />
	</ItemGroup>

	<!-- Tomat supplies these in Debug; the standard build needs them explicitly. -->
	<ItemGroup Condition="'$(Configuration)' != 'Debug'">
		<PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" ExcludeAssets="runtime" />
		<Publicize Include="tModLoader" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
	</ItemGroup>

	<Import Project="Sdk.targets" Sdk="Tomat.Terraria.ModLoader.Sdk" Version="2.1.1" Condition="'$(Configuration)' == 'Debug'" />
	<Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" Condition="'$(Configuration)' != 'Debug'" />
</Project>
